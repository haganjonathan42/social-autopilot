# ---------------------------------------------------------------------------
# social-autopilot configuration
#
# Set every one of these as a Vercel environment variable (Project Settings ->
# Environment Variables). Nothing here belongs in the repo: keep real values in
# .env.local locally, which .gitignore already excludes.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# From the Neon / Vercel Postgres integration. Use the pooled connection string.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Secrets ---------------------------------------------------------------
# Bearer token the daily Claude scheduled task sends to POST /api/drafts.
INTAKE_TOKEN=""
# Password for the dashboard.
DASHBOARD_PASSWORD=""
# Signs the dashboard session cookie. Any long random string.
#   openssl rand -base64 48
SESSION_SECRET=""
# Guards the cron endpoints and /api/admin/migrate. Vercel Cron sends this
# automatically as a Bearer token once it is set here.
CRON_SECRET=""

# --- Platforms -------------------------------------------------------------
# Only platforms listed here are published to. Start with Facebook alone and
# add the others as you get their credentials working.
ENABLED_PLATFORMS="facebook"

# --- GitHub drafts folder (backup intake) ----------------------------------
GITHUB_REPO="haganjonathan42/social-autopilot"
GITHUB_BRANCH="main"
GITHUB_DRAFTS_PATH="drafts"
# Optional: the repo is public, so the importer can read it without a token.
# Worth setting anyway — unauthenticated GitHub API calls are capped at 60 per
# hour, and the importer runs every 15 minutes.
GITHUB_TOKEN=""

# --- Facebook Page ---------------------------------------------------------
# Needs a long-lived Page access token with pages_manage_posts and
# pages_read_engagement.
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
# Optional: pin the Graph API version. Defaults to v21.0.
META_GRAPH_VERSION="v21.0"

# --- Instagram Business ----------------------------------------------------
# The Instagram Business account id (a number, not the @handle). The token is
# usually the same Page token, so this can be left empty.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# --- LinkedIn --------------------------------------------------------------
# Member token with the w_member_social scope.
LINKEDIN_ACCESS_TOKEN=""
# Your own profile: urn:li:person:XXXX
# A company page needs urn:li:organization:XXXX plus w_organization_social,
# which LinkedIn only grants through the Community Management API programme.
LINKEDIN_AUTHOR_URN=""

# --- X ---------------------------------------------------------------------
# OAuth 1.0a user-context credentials from the X developer portal.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
# Used only to build the post's URL in the log.
X_HANDLE=""
# A post containing a link is billed at roughly $0.20 instead of $0.015, so by
# default the link goes out as a reply. Set to "false" to inline it instead.
X_LINK_IN_REPLY="true"
